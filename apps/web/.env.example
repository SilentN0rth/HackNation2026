NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_API_URL=http://localhost:8000

# Payload (panel urzędnika)
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Albo plik z sekretem (Docker secrets), używany gdy PAYLOAD_SECRET jest pusty
# PAYLOAD_SECRET_FILE=/run/secrets/payload_secret
# Baza SQLite i katalog wgranych plików (domyślnie apps/web/data/)
# DATABASE_URL=file:/app/data/payload.db
# MEDIA_DIR=/app/data/media
# true = konto i dane demo zakładane przy starcie serwera (idempotentnie)
# PAYLOAD_SEED=true
# Silnik AI wołany przez hooki Payloada (po stronie serwera)
FASTAPI_URL=http://localhost:8000
# Hasło konta urzędnika z seeda (npm run payload:seed)
SEED_PASSWORD=demo1234
