MAX_UPLOAD_MB=20
MAX_PAGES=40
AUTH_ENABLED=true
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow
JWT_TTL_MIN=480
CORS_ORIGINS=["http://localhost:5173"]
DB_PATH=data/app.db
LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# Model przez Eden AI zamiast lokalnej Ollamy: LLM_ENABLED=true, LLM_PROVIDER=edenai.
# Klucz wpisz tylko tutaj (plik .env jest poza gitem), nigdy w kodzie ani w kliencie.
LLM_PROVIDER=ollama
EDENAI_API_KEY=
EDENAI_MODEL=mistral/mistral-small-2603
DEFAULT_ISSUER=Urząd Gminy
# Klucz do POST /api/v1/convert (nagłówek X-API-Key); pusty = tylko JWT
API_KEY=
# Sekret klienta wymagany przez /auth/token (nagłówek X-Client-Secret); pusty = bez wymogu
TOKEN_CLIENT_SECRET=
